<odoo>

    <record id="email_template_depot_reminder" model="mail.template">
        <field name="name">Reminder Date Depot</field>
        <field name="model_id" ref="crm.model_crm_lead"/>
        <field name="subject">Rappel: Dépôt proche</field>
        <field name="email_to">${object.partner_id.email or object.user_id.email}</field>
        <field name="body_html">
            <![CDATA[
                <p>Bonjour,</p>
                <p>Le dépôt pour l'opportunité <b>${object.name}</b> approche.</p>
                <p>Date de dépôt: ${object.date_depot}</p>
            ]]>
        </field>
    </record>

</odoo>