<odoo>

<record id="view_conversion_wizard_form" model="ir.ui.view">
    <field name="name">ceeri.conversion.wizard.form</field>
    <field name="model">ceeri.conversion.wizard</field>
    <field name="arch" type="xml">
        <form>

            <group>
                <field name="lead_id" invisible="1"/>

                <field name="create_project"/>
                <field name="project_template_id"/>

                <field name="create_sale"/>
                <field name="sale_template_id"/>
            </group>

            <footer>
                <button name="action_convert"
                        type="object"
                        string="Convert"
                        class="btn-primary"/>

                <button string="Cancel"
                        special="cancel"/>
            </footer>

        </form>
    </field>
</record>

</odoo>