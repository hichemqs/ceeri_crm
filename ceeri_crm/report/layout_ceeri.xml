<?xml version="1.0" encoding="UTF-8"?>

<odoo>

    <template id="report_layout_ceeri">

        <t t-call="web.html_container">
            <meta charset="UTF-8"/>
            <style>
            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }
            

            table {
                width: 100%;
                border-collapse: collapse !important;
                border: none !important;
            }

            td, th {
                border: none !important;
                vertical-align: top;
            }

           
            .page {
                font-family: "Segoe UI",Arial, sans-serif;
                font-size: 18px;
                font-weight: bold;
                padding: 0 30px; 
                margin-top: 0;
            }

           
            .title-main {
                font-size: 24px;
                font-weight: bold;
                white-space: nowrap;
            }

            .title-sub {
                font-size: 22px;
                color: #3b82f6;
                font-weight: bold;
                margin-top: 2px;
            }

            .full-line {
                 border: none;
                 border-top: 3px solid #3b82f6;
                 margin: 2px -30px 0 -30px; 
                 width: calc(100% + 60px); 
            }
            
            </style>


            <t t-set="doc" t-value="docs and docs[0] or None"/>

            <t t-set="doc" t-value="docs and docs[0] or None"/>

            <t t-foreach="doc.message_follower_ids.mapped('partner_id')" t-as="p">

                <div class="page" style="page-break-after: always;">

                    <div style="margin-bottom:3px;">

                        <div style="text-align:center; margin-bottom:4mm;">
                            <div style="display:inline-block; text-align:left; margin-left:20mm;">
                                <div class="title-main">
                                    <t t-esc="res_company.name or ''"/>
                                </div>

                                <div style="font-size:22px; color:#3b82f6;">
                        Un Accompagnement sûr !
                                </div>
                            </div>
                        </div>

                        <table style="width:100%;">
                            <tr>


                                <td style="width:30%; vertical-align:top; padding:2mm 0 0 8mm;">
                                    <img t-if="res_company and res_company.logo" t-att-src="image_data_uri(res_company.logo)" style="height:100px; object-fit:contain; margin-bottom:5mm; display:block;"/>
                                </td>


                                <td style="width:70%; vertical-align:top; text-align:right; padding:5mm 20mm 0 0;">

                                    <div style="line-height:1.8; display:inline-block; text-align:left; white-space:nowrap;">

                                        <div>
                                            <img src="data:image/png;base64,"/>
                                            <t t-esc="res_company.partner_id.street or ''"/>
                                        </div>

                                        <div style="margin-top:3px;">
                                            <img src="data:image/png;base64,"/>
                                            <t t-esc="res_company.phone or ''"/>
                                        </div>

                                        <div style="margin-top:3px;">
                                            <img src="data:image/png;base64,"/>
                                            <t t-esc="res_company.website.replace('http://','').replace('https://','') if res_company.website else ''"/>
                                        </div>

                                    </div>

                                </td>

                            </tr>
                        </table>
                    </div>

                    <hr class="full-line"/>

                    <!-- BODY -->
                    <t t-call="ceeri_crm.report_body_ceeri">
                        <t t-set="doc" t-value="doc"/>
                        <t t-set="p" t-value="p"/>
                    </t>

                </div>

            </t>
        </t>
    </template>

</odoo>